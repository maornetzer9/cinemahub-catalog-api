# Copy this file to .env. Do not commit .env.
# On Render, set these in the service environment. A missing .env file is fine
# when the variables are already present in the process environment.

# Required. Use the same value as cinema-ws.
SECRET_KEY=replace-with-a-long-random-string

# Required. Use the same database as cinema-ws so token checks see the same users.
MONGOOSE_URI=mongodb+srv://USER:PASSWORD@cluster.example.net/DATABASE

# Required. One frontend origin, including the scheme. No comma-separated list.
# Local: http://localhost:5173
ORIGIN=http://localhost:5173

# Render sets this. Local default is 3001. Do not hardcode Render's port.
PORT=

# Used only when the movies or members collection is empty.
# The existing shared database is already populated, so these are not needed there.
MOCK_MOVIES_URL=https://example.invalid/movies
MOCK_USERS_URL=https://example.invalid/users

# Render web service "cinemahub-catalog-api"
# Build command: npm install
# Start command: npm start
# Node.js 20 or newer
# SECRET_KEY must match cinemahub-users-api.
# MONGOOSE_URI must use the same database as cinemahub-users-api.
# ORIGIN must be the public frontend origin.
